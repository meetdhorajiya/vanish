# ==============================================================================
# VANISH : Ephemeral Cloud File Sharing Environment Configuration Template
# ==============================================================================

# Application Server Port & Environment
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cryptographic & JWT Security
JWT_SECRET=replace_with_a_secure_random_key_for_production
JWT_EXPIRES_IN=604800

# File Storage & Database Paths
STORAGE_DIR=./data/uploads
DB_PATH=./data/db.json

# Ephemeral File Policies
MAX_FILE_SIZE_MB=50
CLEANUP_INTERVAL_MS=5000
